# ==============================================================================
# S3 Storage Configuration
# ==============================================================================
# Kosongkan S3_ENDPOINT_URL jika menggunakan AWS S3 resmi
# Isi S3_ENDPOINT_URL jika menggunakan NetApp S3 (ONTAP S3 / StorageGRID)
S3_ENDPOINT_URL=https://s3.corp.local:8443
S3_BUCKET_NAME=fortinet-config-backups
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY
S3_REGION=us-east-1
S3_VERIFY_SSL=false

# ==============================================================================
# Fortinet Authentication Credentials
# ==============================================================================
# FortiGate: Gunakan REST API Token
FGT_NODE1_TOKEN=YOUR_FORTIGATE_NODE1_API_TOKEN
FGT_NODE2_TOKEN=YOUR_FORTIGATE_NODE2_API_TOKEN

# FortiWeb: Bisa menggunakan Username & Password (script otomatis meng-encode ke Base64)
# JSON format otomatis: {"username":"user","password":"pwd","vdom":"root"}
FWB_NODE1_USER=admin
FWB_NODE1_PASS=YOUR_FORTIWEB_NODE1_PASSWORD
FWB_NODE2_USER=admin
FWB_NODE2_PASS=YOUR_FORTIWEB_NODE2_PASSWORD

# ATAU jika ingin langsung menggunakan Base64 Token siap pakai:
# FWB_NODE1_TOKEN=eyJ1c2VybmFtZSI6ImFkbWluIiwicGFzc3dvcmQiOiJmb3J0aW5ldCIsInZkb20iOiJyb290In0=
# FWB_NODE2_TOKEN=eyJ1c2VybmFtZSI6ImFkbWluIiwicGFzc3dvcmQiOiJmb3J0aW5ldCIsInZkb20iOiJyb290In0=

# ==============================================================================
# SMTP Mailer Configuration
# ==============================================================================
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# Gunakan true untuk STARTTLS (port 587) atau false jika port 25/465 (SSL)
SMTP_USE_TLS=true
# Gunakan true jika menggunakan SSL langsung (biasanya port 465)
SMTP_USE_SSL=false
SMTP_USER=noc-alerts@perusahaan.com
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=noc-alerts@perusahaan.com
# Daftar penerima email, dipisahkan dengan tanda koma
SMTP_TO=netops@perusahaan.com,security@perusahaan.com

